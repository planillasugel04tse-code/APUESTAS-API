# Betano Live Analyzer — local configuration template
# Copy to .env and fill in your own credentials. NEVER commit .env.

DB_PATH=betano_analyzer.sqlite3

# Telegram / Telethon
TELEGRAM_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=telebet_session
# Comma-separated usernames/IDs, or * for all accessible chats
TELEGRAM_CHANNELS=*

# Live odds freshness
LIVE_STALE_MINUTES=15

# Optional odds providers
ODDSPAPI_KEY=
ODDS_API_KEY=
